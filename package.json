    "change-control",
    "security-audit",
    "software-architecture",
    "reverse-engineering"
  ],
  "bin": {
    "zerodrift-init": "./scripts/init-project.mjs",
    "zerodrift-doctor": "./scripts/doctor.mjs",
    "zerodrift-validate": "./scripts/validate-project.mjs",
    "zerodrift-studio": "./scripts/studio-server.mjs",
    "zerodrift-build-studio": "./scripts/build-studio.mjs",
    "zerodrift-wait-studio": "./scripts/wait-for-studio.mjs",
    "zerodrift-checkpoint": "./scripts/checkpoint.mjs",
    "zerodrift-handoff": "./scripts/handoff.mjs",
    "zerodrift-codemap": "./scripts/code-map.mjs"
